# Railway preenche DATABASE_URL automaticamente ao ligar o Postgres
DATABASE_URL=postgresql://usuario:senha@host:5432/banco
# true quando o banco exige SSL (conexão externa); pela rede interna do Railway use false
DATABASE_SSL=false

# Chave longa e aleatória para assinar os logins
JWT_SECRET=troque-por-uma-chave-longa-e-aleatoria
JWT_EXPIRA_EM=12h

# Dados usados só na primeira subida, quando ainda não existe nenhum usuário
SEED_EMPRESA_NOME=Estabelecimento Exemplo
SEED_ADMIN_NOME=Administrador
SEED_ADMIN_LOGIN=admin@virtualbarra.com
SEED_ADMIN_SENHA=troque-esta-senha
# true cria suítes e quartos de exemplo
SEED_EXEMPLOS=true

# Endereço do frontend (CORS). Vários separados por vírgula. Vazio libera todos.
CORS_ORIGENS=
PORT=8080
