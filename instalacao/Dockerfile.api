# Imagem da API para o servidor local (o Railway não usa este arquivo).
FROM node:20-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY tsconfig*.json ./
COPY src ./src
RUN npm run build && npm prune --omit=dev

FROM node:20-alpine
WORKDIR /app
ARG VB_VERSAO=dev
ENV NODE_ENV=production VB_VERSAO=$VB_VERSAO
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/dist ./dist
COPY package.json ./
EXPOSE 8080
CMD ["node", "dist/main.js"]
